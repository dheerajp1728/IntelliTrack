DEBUG=false
SECRET_KEY=${SECRET_KEY}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database - Use PostgreSQL in test
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@intellitrack-db:5432/intellitrack
DB_HOST=intellitrack-db
DB_PORT=5432
DB_NAME=intellitrack
DB_USER=postgres
DB_PASSWORD=${DB_PASSWORD}

# API
API_HOST=0.0.0.0
API_PORT=8000

# CORS
CORS_ORIGINS=https://intellitrack-test.example.com,https://test.example.com

# Frontend
VITE_API_URL=https://api-test.example.com
VITE_APP_URL=https://intellitrack-test.example.com

# Services
REDIS_URL=redis://intellitrack-redis:6379/0

# Environment
ENVIRONMENT=test
