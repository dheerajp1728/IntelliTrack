DEBUG=false
SECRET_KEY=${SECRET_KEY}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTO_CREATE_TABLES=false
SEED_DATA_ON_STARTUP=false

# Database - Use PostgreSQL in production
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@intellitrack-db.xxxxx.rds.amazonaws.com:5432/intellitrack
DB_HOST=intellitrack-db.xxxxx.rds.amazonaws.com
DB_PORT=5432
DB_NAME=intellitrack
DB_USER=postgres
DB_PASSWORD=${DB_PASSWORD}

# API
API_HOST=0.0.0.0
API_PORT=8000

# CORS
CORS_ORIGINS=https://intellitrack.example.com,https://www.intellitrack.example.com

# Frontend
VITE_API_URL=https://api.intellitrack.example.com
VITE_APP_URL=https://intellitrack.example.com

# Services
REDIS_URL=redis://intellitrack-redis.xxxxx.cache.amazonaws.com:6379
LLM_SERVICE_URL=https://intellitrack-llm.onrender.com

# Environment
ENVIRONMENT=production

# CloudWatch logging
AWS_REGION=us-east-1
AWS_LOG_GROUP=/ecs/intellitrack
