# Backend Configuration
# Local development: sqlite:///./intellitrack.db
# Cloud PostgreSQL: postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./intellitrack.db
DEBUG=false
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTO_CREATE_TABLES=true
SEED_DATA_ON_STARTUP=true

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# LLM Service Configuration
LLM_SERVICE_URL=http://localhost:8001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=intellitrack
DB_USER=postgres
DB_PASSWORD=postgres

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_APP_URL=http://localhost:5173

# Redis (Optional)
REDIS_URL=redis://localhost:6379/0

# AWS Configuration (for cloud deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_ECR_REGISTRY=your-registry-id.dkr.ecr.us-east-1.amazonaws.com

# GCP Configuration
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1

# GitHub Container Registry
GHCR_REGISTRY=ghcr.io
GHCR_OWNER=your-github-username

# Slack Notifications (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
